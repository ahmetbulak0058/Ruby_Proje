<div class="space-y-6">
  <!-- Breadcrumb & Top Navigation -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
      <%= link_to "&larr; Tüm Talepler (Dashboard)".html_safe, root_path, class: "hover:text-indigo-600 transition-colors" %>
      <span>/</span>
      <span class="text-slate-800 font-bold"><%= @ticket.reference_code %></span>
    </div>
    <div class="flex items-center gap-2">
      <%= priority_badge(@ticket.priority) %>
      <%= status_badge(@ticket.status) %>
      <%= sla_badge(@ticket) %>
    </div>
  </div>

  <!-- Ticket Header Details -->
  <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <span class="px-2.5 py-1 rounded-lg bg-indigo-50 font-mono font-extrabold text-sm text-indigo-700 border border-indigo-200">
            <%= @ticket.reference_code %>
          </span>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900"><%= @ticket.subject %></h1>
        </div>
        <div class="mt-2.5 flex flex-wrap items-center gap-y-1 gap-x-4 text-xs text-slate-500">
          <span><strong>Müşteri:</strong> <%= @ticket.customer_name %> &lt;<%= @ticket.customer_email %>&gt;</span>
          <span>&bull;</span>
          <span><strong>Oluşturulma:</strong> <%= @ticket.created_at.strftime("%d.%m.%Y %H:%M") %></span>
          <span>&bull;</span>
          <span><strong>SLA Hedefi:</strong> <%= @ticket.sla_due_at&.strftime("%d.%m.%Y %H:%M") || "Belirlenmedi" %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main 2-Column Content Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Left Column: Message History & Reply Forms (Col 8) -->
    <div class="lg:col-span-8 space-y-6">
      
      <!-- Smart Thank-You Guard Alert Banner -->
      <% if @ticket.reopen_prevented %>
        <div class="rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 p-5 text-white shadow-lg shadow-emerald-500/20 border border-emerald-400">
          <div class="flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-xl shrink-0">
              ⚡
            </div>
            <div>
              <h3 class="text-base font-extrabold tracking-tight">Smart Thank-You Guard Devrede</h3>
              <p class="mt-1 text-sm text-emerald-50 leading-relaxed font-medium">
                Müşteri teşekkür/onay mesajı gönderdiği için bu talep otomatik olarak yeniden açılmadı, 
                <strong>RESOLVED</strong> durumunda korundu ve temsilci SLA performans metrikleriniz koruma altına alındı.
              </p>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Original Ticket Description Card -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center font-bold text-xs">
              <%= @ticket.customer_name.first.upcase %>
            </div>
            <div>
              <span class="font-bold text-slate-900 text-sm"><%= @ticket.customer_name %></span>
              <span class="text-xs text-slate-500 ml-1">(Orijinal Talep Açıklaması)</span>
            </div>
          </div>
          <span class="text-xs text-slate-400"><%= @ticket.created_at.strftime("%d.%m.%Y %H:%M") %></span>
        </div>
        <div class="mt-4 text-sm text-slate-700 leading-relaxed whitespace-pre-line">
          <%= @ticket.description.presence || "Açıklama belirtilmedi." %>
        </div>
      </div>

      <!-- Message History Timeline -->
      <div class="space-y-4">
        <div class="flex items-center justify-between px-1">
          <h2 class="text-base font-extrabold text-slate-900">Mesajlaşma ve Yanıt Geçmişi</h2>
          <span class="text-xs font-semibold text-slate-500"><%= @comments.count %> Mesaj</span>
        </div>

        <% if @comments.empty? %>
          <div class="bg-slate-50 rounded-2xl border border-dashed border-slate-200 p-8 text-center text-sm text-slate-500">
            Henüz ek bir yanıt veya not yazılmadı. Sağdaki paneli veya aşağıdaki formu kullanarak ilk yanıtı gönderebilirsiniz.
          </div>
        <% else %>
          <% @comments.each do |comment| %>
            <% if comment.agent? %>
              <!-- Agent Message Bubble (Indigo/Purple Tint) -->
              <div class="bg-indigo-50/70 border border-indigo-200/90 rounded-2xl p-5 shadow-sm ml-4 sm:ml-8">
                <div class="flex items-center justify-between pb-2 border-b border-indigo-100">
                  <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-xs">
                      T
                    </span>
                    <span class="font-bold text-indigo-950 text-sm"><%= comment.author_name %></span>
                    <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-indigo-200/60 text-indigo-800">
                      Destek Temsilcisi
                    </span>
                  </div>
                  <span class="text-xs text-indigo-500 font-medium"><%= comment.created_at.strftime("%d.%m.%Y %H:%M:%S") %></span>
                </div>
                <div class="mt-3 text-sm text-indigo-950 leading-relaxed whitespace-pre-line font-medium">
                  <%= comment.body %>
                </div>
              </div>
            <% else %>
              <!-- Customer Message Bubble (Slate/White) -->
              <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mr-4 sm:mr-8">
                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                  <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-xs">
                      M
                    </span>
                    <span class="font-bold text-slate-900 text-sm"><%= comment.author_name %></span>
                    <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-100 text-slate-600">
                      Müşteri
                    </span>
                  </div>
                  <span class="text-xs text-slate-400 font-medium"><%= comment.created_at.strftime("%d.%m.%Y %H:%M:%S") %></span>
                </div>
                <div class="mt-3 text-sm text-slate-800 leading-relaxed whitespace-pre-line">
                  <%= comment.body %>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <!-- Interactive Reply Center (Agent & Customer Simulation Tabs) -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-700">Yanıt Merkezi &amp; Simülasyon</h3>
          <div class="flex gap-2">
            <button type="button" 
                    id="tabAgentBtn" 
                    onclick="switchTab('agent')"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 text-white cursor-pointer transition-all">
              Temsilci Olarak Yanıtla
            </button>
            <button type="button" 
                    id="tabCustomerBtn" 
                    onclick="switchTab('customer')"
                    class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer transition-all">
              Müşteri Olarak Yanıtla (Canlı Demo)
            </button>
          </div>
        </div>

        <!-- Form 1: Agent Reply -->
        <div id="agentReplyPanel">
          <%= form_with url: reply_agent_ticket_path(@ticket), method: :post, class: "space-y-3" do |f| %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <%= label_tag :author_name, "Yanıt Veren Temsilci", class: "block text-xs font-bold text-slate-600 mb-1" %>
                <%= text_field_tag :author_name, @ticket.assigned_agent.presence || "Selin Temsilci (Kıdemli Uzman)", class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
              </div>
              <div class="flex items-end">
                <span class="text-xs text-slate-500 mb-2">
                  ℹ️ Yanıt gönderildiğinde ilk yanıt SLA süresi mühürlenir ve durum <strong>PENDING</strong> olur.
                </span>
              </div>
            </div>

            <div>
              <%= label_tag :body, "Temsilci Yanıtı", class: "block text-xs font-bold text-slate-600 mb-1" %>
              <%= text_area_tag :body, nil, rows: 3, placeholder: "Müşteriye teknik çözüm veya ek bilgi talebi yazın...", required: true, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
            </div>

            <div class="flex justify-end">
              <%= submit_tag "Yanıtı Gönder (SLA Mühürle & Pending Yap)", class: "px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/30 cursor-pointer" %>
            </div>
          <% end %>
        </div>

        <!-- Form 2: Customer Reply (For Live Testing Smart Thank-You Guard) -->
        <div id="customerReplyPanel" class="hidden">
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs text-amber-800 mb-3">
            💡 <strong>Smart Thank-You Guard Test Alanı:</strong> Bilet çözüldüğünde (Resolved), aşağıdaki hazır şablonlarla teşekkür korumasının nasıl devreye girdiğini canlı test edebilirsiniz.
          </div>

          <%= form_with url: reply_customer_ticket_path(@ticket), method: :post, class: "space-y-3" do |f| %>
            <div>
              <%= label_tag :author_name, "Müşteri Adı", class: "block text-xs font-bold text-slate-600 mb-1" %>
              <%= text_field_tag :author_name, @ticket.customer_name, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
            </div>

            <!-- Fast Preset Chips for Live Presentation -->
            <div>
              <span class="text-xs font-bold text-slate-600 block mb-1.5">Hızlı Demo Metni Seçin:</span>
              <div class="flex flex-wrap gap-2">
                <button type="button" 
                        onclick="setCustomerText('Harika, sorun çözüldü! Çok teşekkürler.')"
                        class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-emerald-200 cursor-pointer">
                  ✓ "Harika, sorun çözüldü! Çok teşekkürler." (Korumayı Tetikler)
                </button>
                <button type="button" 
                        onclick="setCustomerText('Thank you so much, everything works perfectly!')"
                        class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-emerald-200 cursor-pointer">
                  ✓ "Thank you so much, everything works!" (EN Korumayı Tetikler)
                </button>
                <button type="button" 
                        onclick="setCustomerText('Teşekkürler ama hata hala devam ediyor, bakar mısınız?')"
                        class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-rose-100 text-rose-800 border border-rose-300 hover:bg-rose-200 cursor-pointer">
                  ⚠️ "Teşekkürler ama hata devam ediyor?" (Yeniden Açar)
                </button>
              </div>
            </div>

            <div>
              <%= label_tag :body, "Müşteri Mesajı", class: "block text-xs font-bold text-slate-600 mb-1" %>
              <%= text_area_tag :body, nil, id: "customerBodyInput", rows: 3, placeholder: "Müşteri mesajını buraya yazın veya yukarıdaki hazır şablonlara tıklayın...", required: true, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
            </div>

            <div class="flex justify-end">
              <%= submit_tag "Müşteri Yanıtı Gönder (Guard Testi)", class: "px-5 py-2.5 rounded-xl text-sm font-bold text-slate-800 bg-amber-400 hover:bg-amber-500 shadow-md cursor-pointer" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Column: Management Sidebar (Col 4) -->
    <div class="lg:col-span-4 space-y-6">

      <!-- 1. Durum Akışı Göstergesi (State Stepper) -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">Durum Akışı (State Flow)</h3>
        
        <div class="space-y-3">
          <% steps = [
            ["new", "1. Yeni (New)", "Talep sisteme girdi"],
            ["open", "2. Açık (Open)", "Temsilci atandı / işlemde"],
            ["pending", "3. Bekleyen (Pending)", "Müşteri yanıtı bekleniyor"],
            ["resolved", "4. Çözüldü (Resolved)", "Çözüm sağlandı"],
            ["closed", "5. Kapatıldı (Closed)", "48s sonra otomatik kapandı"]
          ] %>

          <% steps.each do |st_key, st_title, st_desc| %>
            <% is_current = (@ticket.status == st_key) %>
            <div class="flex items-center gap-3 p-2.5 rounded-xl transition-all <%= is_current ? 'bg-indigo-50 border border-indigo-200 shadow-sm' : 'opacity-60' %>">
              <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold <%= is_current ? 'bg-indigo-600 text-white ring-4 ring-indigo-100' : 'bg-slate-200 text-slate-600' %>">
                <%= is_current ? "●" : "○" %>
              </div>
              <div class="flex-1">
                <div class="text-xs font-extrabold <%= is_current ? 'text-indigo-900 font-black' : 'text-slate-700' %>">
                  <%= st_title %>
                </div>
                <div class="text-[11px] text-slate-500"><%= st_desc %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- 2. SLA Sayacı ve Hedefleri -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">SLA Metrikleri</h3>
          <%= sla_badge(@ticket) %>
        </div>

        <div class="bg-slate-50 rounded-xl p-3 border border-slate-200/60 space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-slate-500">Hedef Bitiş:</span>
            <span class="font-bold text-slate-800"><%= @ticket.sla_due_at&.strftime("%d.%m.%Y %H:%M") %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">İlk Yanıt Zamanı:</span>
            <span class="font-bold text-slate-800">
              <%= @ticket.first_responded_at ? @ticket.first_responded_at.strftime("%d.%m.%Y %H:%M:%S") : "Henüz verilmedi" %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Çözüm Zamanı:</span>
            <span class="font-bold text-slate-800">
              <%= @ticket.resolved_at ? @ticket.resolved_at.strftime("%d.%m.%Y %H:%M:%S") : "Çözülmedi" %>
            </span>
          </div>
        </div>

        <% if @ticket.sla_breached? %>
          <div class="p-3 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-800">
            <strong>⚠️ İhlal Tespiti:</strong> İlk yanıt hedeflenen <%= @ticket.priority.upcase %> SLA süresi içinde verilmedi.
          </div>
        <% end %>
      </div>

      <!-- 3. Hızlı Aksiyonlar (Assign & Resolve) -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Temsilci &amp; Çözüm Aksiyonları</h3>

        <!-- Bana Ata -->
        <%= form_with url: assign_ticket_path(@ticket), method: :post do %>
          <%= hidden_field_tag :agent_name, "Selin Temsilci (Kıdemli Destek)" %>
          <button type="submit" class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 shadow-sm cursor-pointer transition-all flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Bana Ata (Selin Temsilci)
          </button>
        <% end %>

        <!-- Talebi Çöz -->
        <% if @ticket.status != "resolved" && @ticket.status != "closed" %>
          <%= form_with url: resolve_ticket_path(@ticket), method: :post do %>
            <button type="submit" class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-md shadow-emerald-600/30 cursor-pointer transition-all flex items-center justify-center gap-1.5">
              ✓ Talebi Çöz (Resolve)
            </button>
          <% end %>
        <% else %>
          <div class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 text-center">
            ✓ Talep Çözülmüş Durumda (<%= @ticket.status.upcase %>)
          </div>
        <% end %>
      </div>

      <!-- 4. DEMO ZAMAN SİMÜLATÖRÜ (Canlı Sunum İçin) -->
      <div class="bg-gradient-to-br from-slate-900 to-indigo-950 text-white rounded-2xl p-5 shadow-xl border border-indigo-500/30 space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-base">⏱️</span>
          <h3 class="text-xs font-black uppercase tracking-wider text-indigo-300">Demo Zaman Simülatörü</h3>
        </div>
        <p class="text-[11px] text-slate-300 leading-normal">
          Canlı sunumda zaman geçişini beklemek zorunda kalmadan mimari zaman kurallarını tetikleyin:
        </p>

        <!-- Simülatör Buton 1: SLA İhlali -->
        <%= form_with url: simulate_time_ticket_path(@ticket), method: :post do %>
          <%= hidden_field_tag :simulation_type, "fast_forward_sla" %>
          <button type="submit" class="w-full py-2 px-3 rounded-lg text-xs font-bold text-rose-200 bg-rose-950/80 hover:bg-rose-900 border border-rose-700/60 shadow-sm cursor-pointer transition-all flex items-center justify-between">
            <span>+3 Saat İleri Sar</span>
            <span class="text-[10px] bg-rose-600 text-white px-1.5 py-0.5 rounded font-extrabold">SLA İHLALİNİ GÖR</span>
          </button>
        <% end %>

        <!-- Simülatör Buton 2: 48 Saat Stale Kapanış -->
        <%= form_with url: simulate_time_ticket_path(@ticket), method: :post do %>
          <%= hidden_field_tag :simulation_type, "fast_forward_stale" %>
          <button type="submit" class="w-full py-2 px-3 rounded-lg text-xs font-bold text-cyan-200 bg-cyan-950/80 hover:bg-cyan-900 border border-cyan-700/60 shadow-sm cursor-pointer transition-all flex items-center justify-between">
            <span>+49 Saat İleri Sar</span>
            <span class="text-[10px] bg-cyan-600 text-white px-1.5 py-0.5 rounded font-extrabold">OTOMATİK KAPAN</span>
          </button>
        <% end %>

        <!-- Simülatör Buton 3: Tekrar Aç -->
        <%= form_with url: simulate_time_ticket_path(@ticket), method: :post do %>
          <%= hidden_field_tag :simulation_type, "reopen" %>
          <button type="submit" class="w-full py-1.5 px-3 rounded-lg text-[11px] font-semibold text-slate-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 cursor-pointer transition-all text-center">
            ↺ Demoyu Sıfırla (Open Yap)
          </button>
        <% end %>
      </div>

    </div>
  </div>
</div>

<script>
  function switchTab(tab) {
    const agentPanel = document.getElementById('agentReplyPanel');
    const customerPanel = document.getElementById('customerReplyPanel');
    const agentBtn = document.getElementById('tabAgentBtn');
    const customerBtn = document.getElementById('tabCustomerBtn');

    if (tab === 'agent') {
      agentPanel.classList.remove('hidden');
      customerPanel.classList.add('hidden');
      agentBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 text-white cursor-pointer transition-all';
      customerBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer transition-all';
    } else {
      customerPanel.classList.remove('hidden');
      agentPanel.classList.add('hidden');
      customerBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500 text-slate-900 cursor-pointer transition-all';
      agentBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer transition-all';
    }
  }

  function setCustomerText(txt) {
    document.getElementById('customerBodyInput').value = txt;
  }
</script>
