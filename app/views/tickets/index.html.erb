<div class="space-y-8">
  <!-- Top Banner & Quick Action -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">SLA &amp; Destek Operasyon Merkezi</h1>
      <p class="mt-1 text-sm text-slate-500 font-medium">B2B kurumsal hizmet taahhütleri, canlı SLA geri sayımı ve akıllı talep yönetimi</p>
    </div>
    <div>
      <button type="button" 
              onclick="document.getElementById('newTicketModal').showModal()"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/30 transition-all cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Yeni Müşteri Talebi Oluştur (Simülasyon)
      </button>
    </div>
  </div>

  <!-- Metric Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <!-- Card 1: Total -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Toplam Talep</p>
        <p class="text-3xl font-extrabold text-slate-900 mt-1"><%= @total_count %></p>
        <p class="text-[11px] text-slate-500 font-medium mt-1">Sistemdeki tüm biletler</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      </div>
    </div>

    <!-- Card 2: Open -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-sky-600">Açık / Aktif Talepler</p>
        <p class="text-3xl font-extrabold text-sky-900 mt-1"><%= @open_count %></p>
        <p class="text-[11px] text-sky-600/80 font-medium mt-1">İşlem bekleyen biletler</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-sky-50 flex items-center justify-center text-sky-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      </div>
    </div>

    <!-- Card 3: SLA Breached (Red Highlight) -->
    <div class="bg-white rounded-2xl p-5 border <%= @breached_count > 0 ? 'border-rose-400 bg-rose-50/20 ring-2 ring-rose-200 shadow-rose-100' : 'border-slate-200/80' %> shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-rose-600 flex items-center gap-1.5">
          <% if @breached_count > 0 %>
            <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
          <% end %>
          SLA İhlali Olanlar
        </p>
        <p class="text-3xl font-extrabold text-rose-700 mt-1"><%= @breached_count %></p>
        <p class="text-[11px] text-rose-600/80 font-medium mt-1">Müdahale süresi aşıldı</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      </div>
    </div>

    <!-- Card 4: Thank-You Guard Protected -->
    <div class="bg-white rounded-2xl p-5 border border-emerald-300 bg-emerald-50/30 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 flex items-center gap-1">
          ⚡ Akıllı Teşekkür Koruması
        </p>
        <p class="text-3xl font-extrabold text-emerald-800 mt-1"><%= @reopen_prevented_count %></p>
        <p class="text-[11px] text-emerald-700 font-semibold mt-1">Gereksiz açılma engellendi</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
    </div>
  </div>

  <!-- Status Filter Navigation Tabs -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200">
    <% tabs = [
      ["all", "Tümü (All)", Ticket.count],
      ["new", "Yeni (New)", Ticket.where(status: 'new').count],
      ["open", "Açık (Open)", Ticket.where(status: 'open').count],
      ["pending", "Bekleyen (Pending)", Ticket.where(status: 'pending').count],
      ["resolved", "Çözülen (Resolved)", Ticket.where(status: 'resolved').count],
      ["closed", "Kapatılan (Closed)", Ticket.where(status: 'closed').count],
      ["breached", "🚨 SLA İhlali", @breached_count]
    ] %>

    <% tabs.each do |key, label, count| %>
      <% is_active = (@current_status == key) %>
      <%= link_to root_path(status: key), 
                  class: "inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all #{is_active ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}" do %>
        <span><%= label %></span>
        <span class="px-1.5 py-0.5 rounded-full text-[11px] font-extrabold <%= is_active ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-700' %>">
          <%= count %>
        </span>
      <% end %>
    <% end %>
  </div>

  <!-- Tickets Table Card -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    <% if @tickets.empty? %>
      <div class="p-12 text-center">
        <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 mx-auto flex items-center justify-center mb-3">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-800">Seçilen filtrede talep bulunamadı</h3>
        <p class="text-sm text-slate-500 mt-1">Farklı bir filtre sekmesi seçebilir veya yeni talep oluşturabilirsiniz.</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/75 border-b border-slate-200 text-slate-500 text-xs font-bold uppercase tracking-wider">
              <th class="py-3.5 px-4 sm:px-6">Kod</th>
              <th class="py-3.5 px-4">Müşteri</th>
              <th class="py-3.5 px-4">Konu</th>
              <th class="py-3.5 px-4">Öncelik</th>
              <th class="py-3.5 px-4">Durum</th>
              <th class="py-3.5 px-4">SLA Durumu</th>
              <th class="py-3.5 px-4">Temsilci</th>
              <th class="py-3.5 px-4 text-right">Detay</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm">
            <% @tickets.each do |ticket| %>
              <tr class="hover:bg-slate-50/80 transition-colors group <%= 'bg-rose-50/20' if ticket.sla_breached? %>">
                <!-- Reference Code -->
                <td class="py-4 px-4 sm:px-6 font-mono font-bold text-indigo-600 whitespace-nowrap">
                  <%= link_to ticket_path(ticket), class: "inline-flex items-center gap-1 hover:underline" do %>
                    <%= ticket.reference_code %>
                  <% end %>
                  <% if ticket.reopen_prevented %>
                    <span title="Smart Thank-You Guard devrede" class="ml-1 inline-block text-emerald-600 font-bold text-xs">⚡</span>
                  <% end %>
                </td>

                <!-- Customer -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <div class="font-bold text-slate-900"><%= ticket.customer_name %></div>
                  <div class="text-xs text-slate-500"><%= ticket.customer_email %></div>
                </td>

                <!-- Subject -->
                <td class="py-4 px-4 max-w-xs truncate font-medium text-slate-800">
                  <%= link_to ticket.subject, ticket_path(ticket), class: "hover:text-indigo-600 transition-colors font-semibold" %>
                  <div class="text-xs text-slate-500 truncate"><%= ticket.description %></div>
                </td>

                <!-- Priority -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <%= priority_badge(ticket.priority) %>
                </td>

                <!-- Status -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <%= status_badge(ticket.status) %>
                </td>

                <!-- SLA Status -->
                <td class="py-4 px-4 whitespace-nowrap">
                  <%= sla_badge(ticket) %>
                </td>

                <!-- Assigned Agent -->
                <td class="py-4 px-4 whitespace-nowrap text-xs text-slate-600">
                  <% if ticket.assigned_agent.present? %>
                    <span class="inline-flex items-center gap-1 font-semibold text-slate-700">
                      <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                      <%= ticket.assigned_agent %>
                    </span>
                  <% else %>
                    <span class="text-slate-400 italic">Atama yapılmadı</span>
                  <% end %>
                </td>

                <!-- Action Button -->
                <td class="py-4 px-4 text-right whitespace-nowrap">
                  <%= link_to ticket_path(ticket), class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 transition-all" do %>
                    Görüntüle &rarr;
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>

<!-- Quick Ticket Simulation Modal -->
<dialog id="newTicketModal" class="rounded-2xl p-0 backdrop:bg-slate-900/40 shadow-2xl max-w-lg w-full border border-slate-200">
  <div class="bg-slate-50 px-6 py-4 border-b border-slate-200 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">+</div>
      <h3 class="text-base font-extrabold text-slate-900">Hızlı Müşteri Talebi Oluştur</h3>
    </div>
    <button type="button" onclick="document.getElementById('newTicketModal').close()" class="text-slate-400 hover:text-slate-600 font-bold text-lg">&times;</button>
  </div>

  <%= form_with model: @new_ticket, url: tickets_path, class: "p-6 space-y-4" do |f| %>
    <div>
      <%= f.label :customer_name, "Müşteri Yetkili Adı", class: "block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1" %>
      <%= f.text_field :customer_name, value: "Canberk Demir (FinTech Corp)", required: true, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :customer_email, "Müşteri E-Posta", class: "block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1" %>
      <%= f.email_field :customer_email, value: "canberk@fintechcorp.io", required: true, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :priority, "Öncelik Seviyesi", class: "block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1" %>
        <%= f.select :priority, [["🔴 Acil (Urgent - 2 Saat)", "urgent"], ["🟠 Yüksek (High - 8 Saat)", "high"], ["🔵 Normal (24 Saat)", "normal"], ["⚪ Düşük (Low - 48 Saat)", "low"]], { selected: "urgent" }, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :subject, "Konu Başlığı", class: "block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1" %>
        <%= f.text_field :subject, value: "Ödeme Geçidi Timeout Hatası (Canlı)", required: true, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>
    </div>

    <div>
      <%= f.label :description, "Talep Açıklaması", class: "block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1" %>
      <%= f.text_area :description, rows: 3, value: "Kredi kartı tahsilat API çağrılarında 30 saniye sonra bağlantı kopuyor. Müşteriler işlem tamamlayamıyor.", class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div class="pt-2 flex items-center justify-end gap-3">
      <button type="button" onclick="document.getElementById('newTicketModal').close()" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-800">Vazgeç</button>
      <%= f.submit "Talebi Kaydet ve Başlat", class: "px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/30 cursor-pointer" %>
    </div>
  <% end %>
</dialog>
